<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP to any host, so a physical device can reach the development
     backend on the computer's LAN address (e.g. http://192.168.1.20:8080). Release builds use the
     restrictive src/main version, which allows cleartext only to the emulator host and loopback.
     InsecureBaseConfiguration is suppressed here deliberately and only for the debug source set. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
