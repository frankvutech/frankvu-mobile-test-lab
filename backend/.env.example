# Environment variables read by the backend (see backend/src/main/kotlin/.../config/AppConfig.kt).
# Defaults are shown; all are optional for local development.
PORT=8080
# H2 file database by default; PostgreSQL example: jdbc:postgresql://localhost:5432/playground
DATABASE_URL=jdbc:h2:file:./data/playground;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
DATABASE_USER=sa
DATABASE_PASSWORD=
# Local development only. Set your own random value anywhere else.
JWT_SECRET=local-development-only-secret-change-me
JWT_ISSUER=mobile-test-playground
TOKEN_TTL_SECONDS=3600
TEST_SUPPORT_ENABLED=true
