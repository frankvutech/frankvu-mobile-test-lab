# Copy to .env (git-ignored) to override docker-compose defaults. These are LOCAL DEVELOPMENT values;
# never reuse them for a shared or public deployment.

# Port the backend is published on (host side).
BACKEND_PORT=8080

# PostgreSQL used by the backend container.
POSTGRES_DB=playground
POSTGRES_USER=playground
POSTGRES_PASSWORD=change-me-locally

# HMAC secret for signing bearer tokens. Generate your own, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-random-local-secret

# Enables POST /api/v1/test/reset and the deterministic error endpoint. Keep true for local
# development and CI only.
TEST_SUPPORT_ENABLED=true
